# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/saas_master?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Email Configuration (Gmail Example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@yourplatform.com
MAIL_FROM_NAME=Your Platform Name

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-long-change-this-in-production
JWT_EXPIRATION=86400000

# Super Admin Configuration
SUPERADMIN_PASSWORD=ChangeThisSecurePassword123!

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Server Configuration
SERVER_PORT=8080

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Levels (optional)
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
SQL_LOG_LEVEL=INFO
SHOW_SQL=false

# Password Reset Configuration
PASSWORD_RESET_EXPIRY=30